# Картинка к каждому сообщению. Если файла нет, бот рисует баннер сам.
BANNER_PATH=assets/banner.png

# Premium-эмодзи на кнопках. Нужен Telegram Premium у владельца бота.
# ID узнать: отправьте боту /emoji и сразу Premium-эмодзи.
# BUTTON_EMOJI ставится на все кнопки, если для кнопки не задан свой ID.
BUTTON_EMOJI=
BUTTON_EMOJI_PROFILE=
BUTTON_EMOJI_SUB=
BUTTON_EMOJI_TOPUP=
BUTTON_EMOJI_SUPPORT=
BUTTON_EMOJI_ABOUT=
BUTTON_EMOJI_BACK=
BUTTON_EMOJI_PLAN=
BUTTON_EMOJI_PAY=
BUTTON_EMOJI_ADMIN=

# Пробный период в днях. Выдаётся один раз и без оплаты.
TRIAL_DAYS=1
