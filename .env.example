# Токен бота от @BotFather
BOT_TOKEN=123456:ABC

# Адрес панели вместе с секретным путём, без слэша в конце.
# Пример: https://1.2.3.4:2053/secretpath
PANEL_URL=https://panel.example.com:2053/secretpath

# Предпочтительно: Settings → Security → API Token.
# Если токен задан, логин и пароль не нужны.
API_TOKEN=

# Запасной вход, если API-токена нет.
PANEL_USERNAME=admin
PANEL_PASSWORD=change-me

# База ссылки подписки без Sub ID и без слэша в конце.
# Берётся в панели: Subscription → sub host, порт (обычно 2096) и subPath.
# Пример: https://1.2.3.4:2096/a1b2c3d4
SUB_BASE_URL=https://panel.example.com:2096/your-sub-path

# ID инбаундов через запятую. Узнать: /inbounds от админа.
INBOUND_IDS=1

# 0 = без лимита трафика. Иначе гигабайты на клиента.
TRAFFIC_GB=0

# 0 = без срока. Иначе дней с момента выдачи.
DAYS=30

# 0 = без лимита одновременных IP.
LIMIT_IP=0

# Для VLESS + Reality обычно xtls-rprx-vision. Пусто — панель сама решит.
FLOW=

# true — кнопка доступна всем. false — только ADMIN_IDS.
ALLOW_ALL=true

# Повторное нажатие возвращает уже выданную ссылку, а не создаёт новую.
ONE_PER_USER=true

# 0 = без общего лимита выдач.
MAX_CLIENTS=0

# Telegram ID админов через запятую. Им доступны /inbounds и /revoke.
ADMIN_IDS=123456789

DB_PATH=data/subs.sqlite

# false, если у панели самоподписанный сертификат.
VERIFY_SSL=true

# Планы зашиты в коде: 30 дней = 100 ₽, 60 = 250 ₽, 90 = 500 ₽.
# Способ оплаты появится в боте, только если заполнены его ключи.

# ЮKassa: shopId и секретный ключ из кабинета.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me/your_bot

# Crypto Pay: @CryptoBot → /pay → Create App. Для теста токен от @CryptoTestnetBot.
CRYPTOPAY_TOKEN=
CRYPTOPAY_TESTNET=false

# 2328: project UUID и API key из настроек проекта.
IO2328_PROJECT=
IO2328_API_KEY=
IO2328_RETURN_URL=https://t.me/your_bot

# Кнопка «Поддержка» в главном меню.
SUPPORT_URL=https://t.me/Heroshish

# Mini-app админ панель
WEBAPP_URL=https://bot.example.com
WEBAPP_PORT=8080
